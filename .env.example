# Copy to .env.local for local development. On Netlify, add these under
# Site configuration -> Environment variables. Never commit real values.

# Free access key from https://web3forms.com (enter the firm's email; the key arrives by email).
# Contact-form enquiries are delivered to that email address.
VITE_WEB3FORMS_ACCESS_KEY=

# The live site address, without a trailing slash. Used for canonical URLs, sitemap.xml and social previews.
VITE_SITE_URL=https://ams-tax-associates.netlify.app
